# Reproducible defaults for the ESP32-S3 N16R8 board used by this project.
CONFIG_IDF_TARGET="esp32s3"

# Module memory: 16 MB quad-SPI flash and 8 MB octal-SPI PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# A/B OTA slots and application-controlled first-boot validation.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Lab trigger defaults. Configure APP_OTA_TEST_URI locally in menuconfig.
CONFIG_APP_OTA_HARDWARE_ID="esp32s3-n16r8"
CONFIG_APP_OTA_MAX_MANIFEST_SIZE=2048
CONFIG_APP_OTA_ALLOW_DOWNGRADE=n
CONFIG_APP_OTA_CONSOLE_ENABLED=n
CONFIG_APP_OTA_BUTTON_TRIGGER_ENABLED=y
CONFIG_APP_OTA_BUTTON_GPIO=0
CONFIG_APP_OTA_BUTTON_HOLD_MS=2000
CONFIG_APP_OTA_TEST_URI=""

# Nursery gateway does not use Bluetooth.
CONFIG_BT_ENABLED=n
CONFIG_APP_MQTT_REPORT_PERIOD_MS=10000
CONFIG_APP_FIRMWARE_RELEASE_SEQUENCE=130
