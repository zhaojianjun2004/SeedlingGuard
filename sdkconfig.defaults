# Reproducible defaults for the ESP32-S3 N16R8 board used by this project.
CONFIG_IDF_TARGET="esp32s3"

# Module memory: 16 MB quad-SPI flash and 8 MB octal-SPI PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# BLE-only NimBLE host. Wi-Fi will be enabled in the next project phase.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
