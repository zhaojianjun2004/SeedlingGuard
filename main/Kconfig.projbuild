menu "Environment monitor configuration"

    config APP_AHT20_SDA_GPIO
        int "AHT20 SDA GPIO"
        range 0 48
        default 8
        help
            GPIO connected to the AHT20 SDA pin. GPIO8 is the recommended
            default for the development board used by this project.

    config APP_AHT20_SCL_GPIO
        int "AHT20 SCL GPIO"
        range 0 48
        default 9
        help
            GPIO connected to the AHT20 SCL pin. GPIO9 is the recommended
            default for the development board used by this project.

    config APP_AHT20_I2C_CLOCK_HZ
        int "AHT20 I2C clock frequency (Hz)"
        range 10000 400000
        default 100000
        help
            Start at 100 kHz for breadboard wiring. The AHT20 data sheet
            permits up to 400 kHz.

    config APP_SENSOR_SAMPLE_PERIOD_MS
        int "Sensor sample period (ms)"
        range 1000 600000
        default 2000
        help
            The AHT20 data sheet recommends an interval longer than one
            second to limit self-heating. This project defaults to 2 seconds.

    config APP_BLE_DEVICE_NAME
        string "BLE device name"
        default "esp32s3-env"
        help
            Name shown in BLE scanner applications. Keep it short enough to
            fit in the legacy advertising or scan-response payload.

    config APP_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        help
            要连接的 2.4 GHz Wi-Fi 名称。留空时不启动 Wi-Fi，
            AHT20 和 BLE 仍会正常运行。

    config APP_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            Wi-Fi 密码。开放网络可留空。不要将包含真实密码的
            sdkconfig 提交到公开仓库。

    config APP_WIFI_RECONNECT_INITIAL_DELAY_MS
        int "Initial Wi-Fi reconnect delay (ms)"
        range 100 60000
        default 1000
        help
            Wi-Fi 断开后第一次重连前的等待时间。

    config APP_WIFI_RECONNECT_MAX_DELAY_MS
        int "Maximum Wi-Fi reconnect delay (ms)"
        range 1000 300000
        default 30000
        help
            指数退避达到此值后，以该固定间隔持续重试。

    config APP_MQTT_BROKER_URI
        string "MQTT Broker URI"
        default ""
        help
            MQTT Broker 地址，例如 mqtt://192.168.1.100:1883。
            留空时不启动 MQTT，其他功能不受影响。

    config APP_MQTT_USERNAME
        string "MQTT username"
        default ""
        help
            MQTT 用户名。局域网匿名 Broker 可留空。

    config APP_MQTT_PASSWORD
        string "MQTT password"
        default ""
        help
            MQTT 密码。不要将包含真实凭据的 sdkconfig 提交到公开仓库。

    config APP_MQTT_REPORT_PERIOD_MS
        int "MQTT telemetry report period (ms)"
        range 1000 3600000
        default 10000
        help
            温湿度遥测消息的默认发布周期。

    config APP_OTA_HEALTH_CONFIRMATION_DELAY_MS
        int "OTA first-boot confirmation delay (ms)"
        range 1000 60000
        default 5000
        help
            新固件首次启动后等待此时间再执行应用健康检查。等待期间如果
            程序崩溃、看门狗复位或掉电，Bootloader 会在下次启动时回滚。

    config APP_OTA_FORCE_BOOT_HEALTH_FAILURE
        bool "Force OTA boot health check failure (test only)"
        default n
        help
            仅用于回滚故障注入实验。启用后，处于 pending verify 的新固件
            会主动判定自检失败并请求回滚。普通启动不会受影响。

    config APP_OTA_HTTP_TIMEOUT_MS
        int "HTTP OTA receive timeout (ms)"
        range 1000 60000
        default 10000
        help
            从电脑 HTTP Server 下载固件时，单次网络读取的超时时间。

    config APP_FIRMWARE_RELEASE_SEQUENCE
        int "Current firmware release sequence"
        range 1 2147483647
        default 121
        help
            当前固件的单调发布序号。版本字符串用于展示，发布序号用于防止
            降级；每个正式候选固件都必须递增。

    config APP_OTA_HARDWARE_ID
        string "OTA hardware compatibility ID"
        default "esp32s3-n16r8"
        help
            Manifest 必须携带完全相同的硬件兼容标识，防止向错误硬件写入
            固件。BMS 中可替换为 PCB/硬件版本族标识。

    config APP_OTA_MAX_MANIFEST_SIZE
        int "Maximum OTA Manifest size (bytes)"
        range 256 8192
        default 2048
        help
            Manifest 文档允许的最大长度，用于限制外部输入和堆内存占用。

    config APP_OTA_ALLOW_DOWNGRADE
        bool "Allow OTA release sequence downgrade (test only)"
        default n
        help
            仅用于受控维修实验。默认拒绝发布序号小于或等于当前固件的包。

    config APP_OTA_DOWNLOAD_BUFFER_SIZE
        int "OTA download buffer size (bytes)"
        range 1024 16384
        default 4096
        help
            HTTP 接收和顺序写入 OTA 分区使用的工作缓冲区大小。

    config APP_OTA_RESTART_DELAY_MS
        int "OTA success restart delay (ms)"
        range 500 10000
        default 2000
        help
            镜像验证并激活成功后，留给日志输出的重启等待时间。

    config APP_OTA_CONSOLE_ENABLED
        bool "Enable interactive OTA serial console"
        default n
        help
            启用 ota start/status 串口命令。后台日志可能干扰交互，因此默认
            关闭，保留为理解命令适配器的可选实验入口。

    config APP_OTA_BUTTON_TRIGGER_ENABLED
        bool "Enable BOOT-button OTA trigger"
        default y
        help
            运行时长按开发板 BOOT 键提交一次 OTA 请求，不依赖串口输入。

    if APP_OTA_BUTTON_TRIGGER_ENABLED

        config APP_OTA_BUTTON_GPIO
            int "OTA trigger button GPIO"
            range 0 48
            default 0
            help
                开发板 BOOT 键通常连接 GPIO0，按下为低电平。

        config APP_OTA_BUTTON_HOLD_MS
            int "OTA trigger hold time (ms)"
            range 500 10000
            default 2000
            help
                按键持续按下达到此时间后才提交请求，避免误触。

        config APP_OTA_TEST_URI
            string "Lab OTA Manifest URI"
            default ""
            help
                仅用于局域网实验，例如 http://192.168.1.10:8000/manifest.json。
                不应把随网络变化的电脑 IP 写进公共 sdkconfig.defaults。

    endif

endmenu
